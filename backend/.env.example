# === Pilih SALAH SATU DATABASE_URL ===

# (A) PRODUKSI / sesuai spec — PostgreSQL (source of truth master data).
#     Jalankan dulu: docker compose up -d db   (dari root repo)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/galaxyas

# (B) DEV CEPAT — SQLite, tanpa perlu server DB. Cukup hapus '#' di bawah
#     dan beri komentar pada baris PostgreSQL di atas.
# DATABASE_URL=sqlite:///./galaxyas_server.db

# CORS: origin desktop app saat dev (Tauri/Vite). Pisahkan dengan koma.
CORS_ORIGINS=http://localhost:1420,http://localhost:5173,tauri://localhost

# Panel admin di /admin (lihat & ubah data langsung). WAJIB diganti untuk produksi.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-ini
ADMIN_SECRET_KEY=ganti-secret-key-ini-untuk-produksi
