# Copy to .env and adjust for your environment.

# MySQL connection (server pusat).
DATABASE_URL=mysql+pymysql://galaxyas:changeme@localhost:3306/galaxyas_pos

# JWT signing. MUST be a long random string in production.
SECRET_KEY=change-this-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS / clients
ALLOWED_ORIGINS=*
